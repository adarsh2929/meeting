
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Room{
  id String @id @default(uuid())
  name String @unique
  capacity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meetings Meeting[]
}


model Meeting{
  id String @id @default(uuid())
  title String?
  description String?
  date DateTime @db.Date
  start DateTime 
  end DateTime
  roomId String
  room Room @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



